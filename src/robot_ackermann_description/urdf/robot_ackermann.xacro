<?xml version="1.0" ?>
<robot name="robot_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find robot_ackermann_description)/urdf/materials.xacro" />
<xacro:include filename="$(find robot_ackermann_description)/urdf/robot_ackermann.ros2control" />
<xacro:include filename="$(find robot_ackermann_description)/urdf/robot_ackermann.gazebo" />
<xacro:include filename="$(find robot_ackermann_description)/urdf/robot_ackermann.ackermann.xacro" />
<link name="base_link">
  <inertial>
    <origin xyz="0.129832431800776 2.585372039371677e-16 0.050000000000000024" rpy="0 0 0"/>
    <mass value="0.949819081119056"/>
    <inertia ixx="0.001855" iyy="0.014566" izz="0.016352" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_ackermann_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_ackermann_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

