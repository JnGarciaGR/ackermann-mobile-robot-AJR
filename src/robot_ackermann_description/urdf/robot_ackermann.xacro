    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="-0.3 -0.11 -0.05" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find robot_ackermann_description)/meshes/front_left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
