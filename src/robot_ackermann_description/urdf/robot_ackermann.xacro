    </geometry>
  </collision>
</link>

<link name="front_left_steer_1">
  <inertial>
    <origin xyz="-0.0011510491346565788 0.0029111292918353876 -0.0005983116710094744" rpy="0 0 0"/>
    <mass value="0.0406510581669991"/>
    <inertia ixx="8e-06" iyy="5e-06" izz="7e-06" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.3 -0.08 -0.05" rpy="0 0 0"/>
