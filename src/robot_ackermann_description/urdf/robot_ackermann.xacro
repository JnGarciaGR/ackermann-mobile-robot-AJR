    <mass value="0.2003634163381743"/>
    <inertia ixx="0.000145" iyy="0.00026" izz="0.000145" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.11 -0.05" rpy="0 0 0"/>
