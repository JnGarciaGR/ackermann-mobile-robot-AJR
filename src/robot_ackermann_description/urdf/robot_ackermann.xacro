<link name="front_left_wheel_1">
  <inertial>
    <origin xyz="-6.622480341889059e-14 0.0 6.938893903907228e-18" rpy="0 0 0"/>
    <mass value="0.20036341633817437"/>
    <inertia ixx="0.000145" iyy="0.00026" izz="0.000145" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
